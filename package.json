{
  "name": "interview-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "cards:build": "tsx scripts/cards-build.ts",
    "cards:lint": "tsx scripts/cards-lint.ts",
    "build": "vite build",
    "dev": "vite",
    "leaks:scan": "tsx scripts/leak-scan.ts",
    "leaks:scan:public": "tsx scripts/leak-scan-public.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx tests/write-e2e-fixture.ts && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run build && npm run leaks:scan:public",
    "verify:vault": "npm run verify && npm run leaks:scan --"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
